# Preserve pinned upstream bytes across Linux/Windows checkouts; their existing
# whitespace belongs to the source checksum, not MNE Lab's formatting style.
web/src/lib/vendor/mbess/*.R -text whitespace=-blank-at-eol,cr-at-eol
web/src/lib/vendor/mbess/*.Rd -text whitespace=-blank-at-eol,cr-at-eol
web/src/lib/vendor/mbess/DESCRIPTION -text whitespace=-blank-at-eol,cr-at-eol

# Preserve independently generated signature fixture bytes on every platform.
testdata/signature/invented.* -text
testdata/signature/invented.csv whitespace=cr-at-eol

# Git-only development continuity; omit it from product/source distributions.
/development/continuity export-ignore
/development/continuity/** export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
